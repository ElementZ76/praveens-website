# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored; this example file is committed so everyone knows which settings exist.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio_app
DB_PASSWORD=change-me
# Optional: database the tests use (default portfolio_test)
# DB_TEST_NAME=portfolio_test
# SSL mode: prefer locally; verify-full in production (Neon)
DB_SSLMODE=prefer
